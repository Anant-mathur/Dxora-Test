# Copy to .env and fill in. Never commit .env.
# Pick ONE provider: gemini | anthropic | openai
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.1-flash-lite

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional fallback if the primary provider fails (needs its key above)
LLM_FALLBACK_PROVIDER=anthropic
LLM_FALLBACK_MODEL=claude-haiku-5-5

# Optional tuning
# LLM_PRIMARY_BUDGET_SECONDS=30   # max time for the primary provider before the fallback takes over
# MAX_CONTENT_CHARS=14000
# CACHE_TTL_SECONDS=3600
# RATE_LIMIT_PER_MINUTE=10
# TRUST_PROXY=true        # set on Render/Railway/etc so the rate limit sees real client IPs

# Local only: trust the OS cert store behind TLS-inspecting proxies
# USE_SYSTEM_CERTS=true
